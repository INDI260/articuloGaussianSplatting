@article{Gudon2024,
   abstract = {We propose a method to allow precise and extremely fast mesh extraction from 3D Gaussian Splatting [15]. Gaussian Splatting has recently become very popular as it yields realistic rendering while being significantly faster to train than NeRFs. It is however challenging to extract a mesh from the millions of tiny 3D Gaussians as these Gaussians tend to be unorganized after optimization and no method has been proposed so far. Our first key contribution is a regularization term that encourages the Gaussians to align well with the surface of the scene. We then introduce a method that exploits this alignment to extract a mesh from the Gaussians using Poisson reconstruction, which is fast, scalable, and preserves details, in contrast to the Marching Cubes algorithm usually applied to extract meshes from Neural SDFs. Finally, we introduce an optional refinement strategy that binds Gaussians to the surface of the mesh, and jointly optimizes these Gaussians and the mesh through Gaussian splatting rendering. This enables easy editing, sculpting, animating, and relighting of the Gaussians by manipulating the mesh instead of the Gaussians themselves. Retrieving such an editable mesh for realistic rendering is done within minutes with our method, compared to hours with the state-of-the-art method on SDFs, while providing a better rendering quality.},
   author = {Antoine Guédon and Vincent Lepetit},
   doi = {10.1109/CVPR52733.2024.00512},
   isbn = {9798350353006},
   issn = {10636919},
   journal = {Proceedings of the IEEE Computer Society Conference on Computer Vision and Pattern Recognition},
   keywords = {3D from Multi-view and Sensors,Differentiable Rendering,Gaussian Splatting,Mesh,Novel View Synthesis,Surface reconstruction},
   pages = {5354-5363},
   publisher = {IEEE Computer Society},
   title = {SuGaR: Surface-Aligned Gaussian Splatting for Efficient 3D Mesh Reconstruction and High-Quality Mesh Rendering},
   url = {https://openurl.ebsco.com/contentitem/doi:10.1109/CVPR52733.2024.00512?sid=ebsco:plink:crawler&id=ebsco:doi:10.1109/CVPR52733.2024.00512&crl=c},
   year = {2024}
}
@article{Cascarano2025,
   abstract = {In this paper, we compare different 3D reconstruction methods for creating detailed digital 3D models, focusing on structured light scanning using the Artec Eva device, LiDAR scanning with the iPhone 12 Pro and the Scaniverse app, and video-based methods like the Android Polycam app and a proposed Gaussian Splatting-based pipeline. By evaluating these methods on metrics of image quality, processing time, cost, and device compatibility, we aim to identify the most suitable approach for creating high-fidelity 3D models within an Extended Reality collaborative platform. Our findings highlight the tradeoffs among these methods, with the proposed Gaussian Splatting-based pipeline emerging as a promising approach due to its balance of high-quality output, efficiency, and device flexibility.},
   author = {Pasquale Cascarano and Jacopo Meglioraldi and Giacomo Vallasciani and Vincenzo Armandi and Giulio Augello and Silvano Carradori and Shirin Hajahmadi and Gustavo Marfia},
   doi = {10.1109/AIXVR63409.2025.00041},
   isbn = {9798331521578},
   journal = {Proceedings - 2025 IEEE International Conference on Artificial Intelligence and eXtended and Virtual Reality, AIxVR 2025},
   keywords = {3D models,Artec Eva,Gaussian Splatting,LiDAR,Polycam,Scaniverse,Structured Light,eXtended Reality},
   pages = {213-217},
   publisher = {Institute of Electrical and Electronics Engineers Inc.},
   title = {A Comparative Analysis of 3D Modeling Methods for Integration into an Extended Reality Platform},
   url = {https://ieeexplore.ieee.org/document/10896185},
   year = {2025}
}
